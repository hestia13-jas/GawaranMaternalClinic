PORT=3000
NODE_ENV=development

# Supabase (https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side (same anon key; exposed to browser via /api/config)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL (required for password reset emails — must match Supabase redirect allow list)
APP_URL=http://localhost:3000

# Gmail SMTP for 2FA OTP emails (use Google App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gawaranclinic@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Gawaran Maternal Clinic <gawaranclinic@gmail.com>

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_COOKIE_NAME=gmc_session
